# Django
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (MySQL)
DB_NAME=settlement_db
DB_USER=user
DB_PASSWORD=password
DB_HOST=mysql # docker-compose service name or actual host
DB_PORT=3306

# Cache (Redis)
REDIS_HOST=redis # docker-compose service name or actual host
REDIS_PORT=6379
REDIS_DB_DEFAULT=1
REDIS_DB_CELERY_RESULTS=2

# Message Queue (RabbitMQ)
RABBITMQ_HOST=rabbitmq # docker-compose service name or actual host
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Celery
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Encryption Key (generate using Fernet.generate_key().decode())
FIELD_ENCRYPTION_KEY=your_fernet_encryption_key_here

# Alipay ISV
ALIPAY_ISV_APP_ID=your_isv_app_id
ALIPAY_ISV_APP_PRIVATE_KEY="your_app_private_key_string_here"
ALIPAY_ISV_ALIPAY_PUBLIC_KEY="alipay_public_key_string_here"
ALIPAY_ISV_DEFAULT_NOTIFY_URL=https://yourapi.com/api/v1/payments/alipay/notify/
ALIPAY_ISV_DEFAULT_RETURN_URL=https://yourfrontend.com/payment/return/
ALIPAY_ISV_OAUTH_CALLBACK_URL=https://yourapi.com/api/v1/preparation/alipay/isv-auth-callback/
